"""
ga/genetic_algorithm.py
=======================
Optimised Hybrid GA-ALNS main loop.

Key changes versus the previous version:
  1. top_k_alns is enforced strictly: ALNS is applied only to the best k
     decoded offspring, instead of all offspring.
  2. Termination metadata is exposed via stop_reason, generations_executed,
     and stagnation_count for Taguchi diagnostics.
  3. Population diversity is protected: after duplicate removal, the
     population is refilled with repaired random individuals.
  4. Demand heuristic is lead-time-aware: an OA order at period t is scored
     against shortage/backorder risk around its arrival period.
  5. A bounded OA-transfer local search improves top offspring by moving
     capacity between warehouses in the same order period while preserving
     sum_i Q_OA[i,t] == CAP[t].
  6. V6 adds direct Q_PLT quantity genes and solver-free PLT quantity local search.
     No Gurobi/MILP is called inside the heuristic.
"""
from __future__ import annotations

import random
import time
from dataclasses import dataclass, field
from typing import Callable, Dict, List, Optional, Tuple

from ..core.constraints import ConstraintHandler
from ..core.decoder import Decoder
from ..core.objective import DecodedSolution, ObjectiveCalculator
from ..core.problem import Problem, QOAChrom, Wh, Pd, qplt_key, is_qplt_key
from .operators import GeneticOperators


@dataclass
class Individual:
    chrom: QOAChrom
    fitness: float = float("inf")
    sol: Optional[DecodedSolution] = field(default=None, repr=False)


class GeneticAlgorithm:
    """Population-based GA with selective Lamarckian ALNS local search."""

    def __init__(
        self,
        problem: Problem,
        decoder: Decoder,
        obj_calc: ObjectiveCalculator,
        constraint: ConstraintHandler,
        operators: GeneticOperators,
        alns_solver,
        n_pop: int = 50,
        G_max: int = 300,
        G_stag: int = 60,
        k_tournament: int = 3,
        delta_G: int = 5,
        top_k_alns: int = 10,
        time_limit_s: float = 300.0,
        milp_seed: Optional[QOAChrom] = None,
        rng: random.Random | None = None,
        log_callback: Optional[Callable[[int, float], None]] = None,
        enable_local_search: bool = True,
        local_search_top_k: int = 3,
        local_search_max_trials: int = 100,
        milp_seed_fraction: float = 0.35,
        heuristic_fraction: float = 0.45,
    ) -> None:
        self._p = problem
        self._dec = decoder
        self._eval = obj_calc
        self._ch = constraint
        self._ops = operators
        self._alns = alns_solver
        self._n_pop = max(2, int(n_pop))
        self._G_max = max(1, int(G_max))
        self._G_stag = max(1, int(G_stag))
        self._k_tour = max(1, int(k_tournament))
        self._delta_G = max(1, int(delta_G))
        self._top_k = max(0, int(top_k_alns))
        self._time_limit = float(time_limit_s)
        self._milp_seed = milp_seed
        self._rng = rng or random.Random()
        self._log = log_callback
        self._milp_seed_fraction = min(max(float(milp_seed_fraction), 0.0), 1.0)
        self._heuristic_fraction = min(max(float(heuristic_fraction), 0.0), 1.0)

        # Bounded intensification after ALNS. Defaults are intentionally
        # conservative because each trial requires one full decode.
        self._enable_local_search = bool(enable_local_search)
        self._ls_top_k = max(0, int(local_search_top_k))
        self._ls_max_trials = max(0, int(local_search_max_trials))
        self._plt_ls_max_trials = max(10, self._ls_max_trials // 2)

        # Exposed for experiment diagnostics.
        self.stop_reason: str = "UNKNOWN"
        self.generations_executed: int = 0
        self.stagnation_count: int = 0
        self.best_fitness: float = float("inf")

    # ------------------------------------------------------------------
    # Public entry point
    # ------------------------------------------------------------------

    def run(self) -> Tuple[QOAChrom, DecodedSolution]:
        """Run Hybrid GA-ALNS and return (best_chromosome, best_solution)."""
        t_start = time.perf_counter()
        self.stop_reason = "UNKNOWN"
        self.generations_executed = 0
        self.stagnation_count = 0
        self.best_fitness = float("inf")

        if hasattr(self._alns, "reset_weights"):
            self._alns.reset_weights()

        pop = self._init_population()
        self._evaluate_population(pop)
        pop.sort(key=lambda ind: ind.fitness)

        best = self._clone_individual(pop[0])
        self.best_fitness = best.fitness
        no_impr = 0
        gen = 0

        while gen < self._G_max and no_impr < self._G_stag:
            if time.perf_counter() - t_start >= self._time_limit:
                self.stop_reason = "TIME_LIMIT"
                break

            gen += 1
            self.generations_executed = gen

            parents = self._tournament_select(pop)

            offspring: List[Individual] = []
            it = iter(parents)
            for p1, p2 in zip(it, it):
                c1, c2 = self._ops.crossover(p1.chrom, p2.chrom)
                c1 = self._ch.repair(self._ops.mutate(c1))
                c2 = self._ch.repair(self._ops.mutate(c2))
                offspring.extend([Individual(c1), Individual(c2)])

            if len(parents) % 2 == 1:
                last = self._ch.repair(self._ops.mutate(dict(parents[-1].chrom)))
                offspring.append(Individual(last))

            # Decode all offspring first. This makes top-k ALNS meaningful.
            self._evaluate_population(offspring)

            use_alns = (gen % self._delta_G == 0) or (no_impr >= self._G_stag // 2)
            if use_alns and self._top_k > 0:
                offspring.sort(key=lambda ind: ind.fitness)
                for ind in offspring[: min(self._top_k, len(offspring))]:
                    if time.perf_counter() - t_start >= self._time_limit:
                        self.stop_reason = "TIME_LIMIT"
                        break

                    assert ind.sol is not None
                    sol, improved_chrom = self._alns.run(ind.chrom, ind.sol)
                    ind.chrom = improved_chrom
                    ind.fitness = sol.fitness
                    ind.sol = sol

            # Bounded OA-transfer local search on the best few offspring.
            # This is cheap compared with ALNS and directly exploits the
            # capacity equality: move quantity from low-value warehouses to
            # high-risk warehouses in the same order period.
            if self._enable_local_search and self._ls_top_k > 0 and self._ls_max_trials > 0:
                offspring.sort(key=lambda ind: ind.fitness)
                for ind in offspring[: min(self._ls_top_k, len(offspring))]:
                    if time.perf_counter() - t_start >= self._time_limit:
                        self.stop_reason = "TIME_LIMIT"
                        break
                    assert ind.sol is not None
                    ls_sol, ls_chrom = self._oa_transfer_local_search(ind.chrom, ind.sol, t_start)
                    if ls_sol.fitness + 1e-9 < ind.fitness:
                        ind.chrom = ls_chrom
                        ind.fitness = ls_sol.fitness
                        ind.sol = ls_sol

            # V5: bounded PLT-quantity local search.  This changes only route
            # quantity genes; Q_OA remains fixed.  It is still pure heuristic
            # and does not call any exact solver.
            if self._enable_local_search and self._plt_ls_max_trials > 0:
                offspring.sort(key=lambda ind: ind.fitness)
                for ind in offspring[: min(self._ls_top_k, len(offspring))]:
                    if time.perf_counter() - t_start >= self._time_limit:
                        self.stop_reason = "TIME_LIMIT"
                        break
                    assert ind.sol is not None
                    pls_sol, pls_chrom = self._plt_quantity_local_search(ind.chrom, ind.sol, t_start)
                    if pls_sol.fitness + 1e-9 < ind.fitness:
                        ind.chrom = pls_chrom
                        ind.fitness = pls_sol.fitness
                        ind.sol = pls_sol

            combined = pop + offspring
            combined.sort(key=lambda ind: ind.fitness)

            pop = self._deduplicate(combined)
            pop = pop[: self._n_pop]
            self._refill_population(pop)
            pop.sort(key=lambda ind: ind.fitness)

            if pop[0].fitness + 1e-9 < best.fitness:
                best = self._clone_individual(pop[0])
                self.best_fitness = best.fitness
                no_impr = 0
            else:
                no_impr += 1

            self.stagnation_count = no_impr

            if self._log:
                self._log(gen, best.fitness)

        if self.stop_reason == "UNKNOWN":
            if no_impr >= self._G_stag:
                self.stop_reason = "G_STAG"
            elif gen >= self._G_max:
                self.stop_reason = "G_MAX"
            elif time.perf_counter() - t_start >= self._time_limit:
                self.stop_reason = "TIME_LIMIT"
            else:
                self.stop_reason = "COMPLETED"

        assert best.sol is not None
        return best.chrom, best.sol

    # ------------------------------------------------------------------
    # Population initialisation
    # ------------------------------------------------------------------

    def _init_population(self) -> List[Individual]:
        p = self._p
        n = self._n_pop
        rng = self._rng
        pop: List[Individual] = []

        if self._milp_seed is not None:
            seed = self._ch.repair(dict(self._milp_seed))
            self._ensure_plt_quantities(seed, noisy=True)
            pop.append(Individual(seed))

            n_milp_perturb = max(1, int(self._milp_seed_fraction * n))
            while len(pop) < n_milp_perturb:
                perturbed: QOAChrom = {}
                for wh in p.warehouses:
                    for t in p.periods:
                        eps = rng.uniform(-0.25, 0.25)
                        v = max(0, int(seed.get((wh, t), 0) * (1.0 + eps)))
                        perturbed[(wh, t)] = v
                perturbed = self._ch.repair(perturbed)
                self._ensure_plt_quantities(perturbed, noisy=True)
                pop.append(Individual(perturbed))
            n_milp_used = len(pop)
        else:
            n_milp_used = 0

        n_heuristic_target = int(self._heuristic_fraction * n)
        while len(pop) < n_milp_used + n_heuristic_target and len(pop) < n:
            pop.append(Individual(self._demand_heuristic_chrom(noise=True)))

        while len(pop) < n:
            pop.append(Individual(self._random_chromosome()))

        return pop

    def _demand_heuristic_chrom(self, noise: bool = False) -> QOAChrom:
        """Lead-time-aware proportional allocation based on arrival-period risk."""
        p = self._p
        rng = self._rng
        chrom: QOAChrom = {}
        last_t = p.periods[-1]

        for order_t in p.periods:
            scores: Dict[Wh, float] = {}
            for wh in p.warehouses:
                arrival_t = order_t + p.LT_OA[wh] - 1
                if arrival_t > last_t:
                    scores[wh] = 0.0
                    continue

                projected = p.BI.get(wh, 0.0)
                for tau in p.periods:
                    if tau > arrival_t:
                        break
                    projected += p.delta_I.get((wh, tau), 0.0)

                floor = p.L.get((wh, arrival_t), 0.0)
                shortage = max(floor - projected, 0.0)
                backorder = max(-projected, 0.0)
                score = (
                    p.Cs.get((wh, arrival_t), 0.0) * shortage
                    + p.Cb.get((wh, arrival_t), 0.0) * backorder
                )
                if noise:
                    score *= rng.uniform(0.8, 1.2)
                scores[wh] = score

            self._allocate_period_by_scores(chrom, order_t, scores)

        chrom = self._ch.repair(chrom)
        self._ensure_plt_quantities(chrom, noisy=noise)
        return chrom

    def _random_chromosome(self) -> QOAChrom:
        """Dirichlet-style random chromosome without requiring NumPy."""
        p = self._p
        rng = self._rng
        chrom: QOAChrom = {}

        for t in p.periods:
            weights = [rng.expovariate(1.0) for _ in p.warehouses]
            total_w = sum(weights) or 1.0
            cap = int(round(p.CAP[t]))
            raw = [w / total_w * cap for w in weights]
            ints = [int(v) for v in raw]
            diff = cap - sum(ints)
            order = sorted(range(len(raw)), key=lambda k: -(raw[k] - ints[k]))
            for k in range(max(0, diff)):
                ints[order[k % len(order)]] += 1
            for wh, v in zip(p.warehouses, ints):
                chrom[(wh, t)] = max(0, v)

        chrom = self._ch.repair(chrom)
        self._ensure_plt_quantities(chrom, noisy=True)
        return chrom

    def _allocate_period_by_scores(self, chrom: QOAChrom, t: Pd, scores: Dict[Wh, float]) -> None:
        p = self._p
        cap = int(round(p.CAP[t]))
        total = sum(max(v, 0.0) for v in scores.values())

        if total <= 0:
            base = cap // len(p.warehouses)
            remainder = cap - base * len(p.warehouses)
            for idx, wh in enumerate(p.warehouses):
                chrom[(wh, t)] = base + (1 if idx < remainder else 0)
            return

        raw = {wh: max(scores[wh], 0.0) / total * cap for wh in p.warehouses}
        ints = {wh: int(v) for wh, v in raw.items()}
        diff = cap - sum(ints.values())
        ordered = sorted(p.warehouses, key=lambda w: -(raw[w] - ints[w]))
        for idx in range(max(0, diff)):
            ints[ordered[idx % len(ordered)]] += 1
        for wh in p.warehouses:
            chrom[(wh, t)] = max(0, ints[wh])


    # ------------------------------------------------------------------
    # V6: Direct Q_PLT quantity genes
    # ------------------------------------------------------------------

    def _ensure_plt_quantities(self, chrom: QOAChrom, noisy: bool = False) -> None:
        """Create missing direct Q_PLT genes in-place using a cheap risk/surplus proxy."""
        p = self._p
        rng = self._rng
        last_t = p.periods[-1]

        for ship_t in p.periods:
            cap_proxy = max(1.0, p.CAP.get(ship_t, 1.0))
            for src in p.warehouses:
                source_inv = self._project_no_plt_inventory(src, ship_t)
                source_floor = p.L.get((src, ship_t), 0.0)
                source_surplus = max(source_inv - source_floor, 0.0)

                for dst in p.warehouses:
                    if src == dst or not p.plt_valid(src, dst, ship_t):
                        continue

                    key = qplt_key(src, dst, ship_t)
                    if key in chrom:
                        try:
                            chrom[key] = max(0.0, float(chrom[key]))
                        except Exception:
                            chrom[key] = 0.0
                        continue

                    lt = p.LT_PLT.get((src, dst))
                    if lt is None:
                        chrom[key] = 0.0
                        continue
                    arr_t = ship_t + lt
                    if arr_t > last_t:
                        chrom[key] = 0.0
                        continue

                    dst_inv = self._project_no_plt_inventory(dst, arr_t)
                    dst_floor = p.L.get((dst, arr_t), 0.0)
                    dst_need = max(dst_floor - dst_inv, -dst_inv, 0.0)
                    if source_surplus <= 0 or dst_need <= 0:
                        base_q = 0.0
                    else:
                        transport = p.dist.get((src, dst), p.dist.get((dst, src), 0.0)) * p.TC
                        dst_risk = (
                            p.Cs.get((dst, arr_t), 0.0) * max(dst_floor - dst_inv, 0.0)
                            + p.Cb.get((dst, arr_t), 0.0) * max(-dst_inv, 0.0)
                        )
                        proxy = min(source_surplus, dst_need) * max(dst_risk, 1.0) - transport
                        base_q = min(source_surplus, dst_need) if proxy > 0 else 0.0

                    if noisy:
                        if rng.random() < 0.25:
                            base_q = rng.uniform(0.0, 0.35 * cap_proxy)
                        else:
                            base_q *= rng.uniform(0.55, 1.35)

                    chrom[key] = max(0.0, base_q)

    def _project_no_plt_inventory(self, wh: Wh, target_t: Pd) -> float:
        """Crude projected inventory without PLT, used only for Q_PLT seeding."""
        p = self._p
        inv = p.BI.get(wh, 0.0)
        for tau in p.periods:
            if tau > target_t:
                break
            inv += p.delta_I.get((wh, tau), 0.0)
            order_t = tau - p.LT_OA[wh] + 1
            if order_t in p.periods:
                inv += p.CAP.get(order_t, 0.0) / max(len(p.warehouses), 1)
        return inv


    # ------------------------------------------------------------------
    # Bounded local search: OA transfer moves
    # ------------------------------------------------------------------

    def _oa_transfer_local_search(
        self,
        chrom: QOAChrom,
        sol: DecodedSolution,
        t_start: float,
    ) -> Tuple[DecodedSolution, QOAChrom]:
        """
        First-improvement local search using same-period OA transfer moves.

        Move form:
            Q_OA[donor, t]   -= delta
            Q_OA[receiver, t] += delta

        This preserves the equality capacity constraint for period t. Candidate
        periods are selected by mapping high-cost arrival periods back to the
        order period that can affect them.
        """
        p = self._p
        best_chrom = dict(chrom)
        best_sol = sol
        best_f = sol.fitness

        if self._ls_max_trials <= 0:
            return best_sol, best_chrom

        # Rank order periods by the inventory cost they can influence.
        order_cost = {t: 0.0 for t in p.periods}
        for wh in p.warehouses:
            for arrival_t in p.periods:
                order_t = arrival_t - p.LT_OA[wh] + 1
                if order_t in order_cost:
                    inv = best_sol.I.get((wh, arrival_t), 0.0)
                    order_cost[order_t] += self._inventory_cost(wh, arrival_t, inv)

        n_period_candidates = min(len(p.periods), max(4, len(p.periods) // 4))
        period_candidates = sorted(p.periods, key=lambda t: -order_cost[t])[:n_period_candidates]

        trials = 0
        improved = True
        while improved and trials < self._ls_max_trials:
            improved = False

            for order_t in period_candidates:
                if trials >= self._ls_max_trials:
                    break
                if time.perf_counter() - t_start >= self._time_limit:
                    self.stop_reason = "TIME_LIMIT"
                    return best_sol, best_chrom

                risk = self._arrival_risk_scores(order_t, best_sol)
                receivers = sorted(p.warehouses, key=lambda w: -risk.get(w, 0.0))[:3]
                donors = sorted(p.warehouses, key=lambda w: risk.get(w, 0.0))[:3]

                for receiver in receivers:
                    for donor in donors:
                        if trials >= self._ls_max_trials:
                            break
                        if donor == receiver:
                            continue

                        donor_qty = int(best_chrom.get((donor, order_t), 0))
                        if donor_qty <= 0:
                            continue

                        cp_receiver = max(1, p.case_pack(receiver, order_t))
                        cp_donor = max(1, p.case_pack(donor, order_t))
                        cap = max(1, int(round(p.CAP[order_t])))

                        candidate_deltas = []
                        for d in (cp_receiver, cp_donor, max(1, int(0.05 * cap)), max(1, int(0.10 * cap))):
                            if 0 < d <= donor_qty and d not in candidate_deltas:
                                candidate_deltas.append(d)

                        for delta in candidate_deltas:
                            if trials >= self._ls_max_trials:
                                break
                            trials += 1

                            cand = dict(best_chrom)
                            cand[(donor, order_t)] = cand.get((donor, order_t), 0) - delta
                            cand[(receiver, order_t)] = cand.get((receiver, order_t), 0) + delta

                            # Sum capacity is preserved by construction and both
                            # quantities remain non-negative. Do NOT call full repair
                            # here: repair may redistribute the whole period and hide
                            # the true marginal value of this transfer move.
                            cand_sol = self._dec.decode(cand)

                            if cand_sol.fitness + 1e-9 < best_f:
                                best_chrom = cand
                                best_sol = cand_sol
                                best_f = cand_sol.fitness
                                improved = True
                                break

                        if improved:
                            break
                    if improved:
                        break
                if improved:
                    break

        return best_sol, best_chrom

    def _inventory_cost(self, wh: Wh, t: Pd, inv: float) -> float:
        p = self._p
        return (
            p.Co.get((wh, t), 0.0) * max(inv - p.U.get((wh, t), 1e9), 0.0)
            + p.Cs.get((wh, t), 0.0) * max(p.L.get((wh, t), 0.0) - inv, 0.0)
            + p.Cb.get((wh, t), 0.0) * max(-inv, 0.0)
        )

    def _arrival_risk_scores(self, order_t: Pd, sol: DecodedSolution) -> Dict[Wh, float]:
        """Score warehouses by marginal risk at the OA arrival period."""
        p = self._p
        scores: Dict[Wh, float] = {}
        last_t = p.periods[-1]

        for wh in p.warehouses:
            arrival_t = order_t + p.LT_OA[wh] - 1
            if arrival_t > last_t:
                scores[wh] = 0.0
                continue

            prev_t = arrival_t - 1
            prev_inv = sol.I.get((wh, prev_t), p.BI.get(wh, 0.0))
            projected = prev_inv + p.delta_I.get((wh, arrival_t), 0.0)

            floor = p.L.get((wh, arrival_t), 0.0)
            ceiling = p.U.get((wh, arrival_t), 1e9)

            shortage = max(floor - projected, 0.0)
            backorder = max(-projected, 0.0)
            overstock = max(projected - ceiling, 0.0)

            scores[wh] = max(
                p.Cs.get((wh, arrival_t), 0.0) * shortage
                + p.Cb.get((wh, arrival_t), 0.0) * backorder
                - 0.25 * p.Co.get((wh, arrival_t), 0.0) * overstock,
                0.0,
            )

        return scores


    def _plt_quantity_local_search(
        self,
        chrom: QOAChrom,
        sol: DecodedSolution,
        t_start: float,
    ) -> Tuple[DecodedSolution, QOAChrom]:
        """Improve direct Q_PLT genes by increasing useful arcs and suppressing harmful arcs."""
        p = self._p
        best_chrom = dict(chrom)
        best_sol = sol
        best_f = sol.fitness
        trials = 0

        # High-cost receiver periods: increase inbound Q_PLT requests that can arrive there.
        costly_cells = []
        for wh in p.warehouses:
            for t in p.periods:
                inv = sol.I.get((wh, t), 0.0)
                cost = self._inventory_cost(wh, t, inv)
                if cost > 0:
                    costly_cells.append((cost, wh, t))
        costly_cells.sort(reverse=True)

        for _, dst, arrival_t in costly_cells[: min(len(costly_cells), 12)]:
            if trials >= self._plt_ls_max_trials:
                break
            if time.perf_counter() - t_start >= self._time_limit:
                self.stop_reason = "TIME_LIMIT"
                break

            for src in p.warehouses:
                if src == dst:
                    continue
                lt = p.LT_PLT.get((src, dst))
                if lt is None:
                    continue
                ship_t = arrival_t - lt
                if ship_t not in p.periods or not p.plt_valid(src, dst, ship_t):
                    continue

                key = qplt_key(src, dst, ship_t)
                base = float(best_chrom.get(key, 0.0))
                cap_proxy = max(1.0, p.CAP.get(ship_t, 1.0))
                increments = [
                    max(1.0, 0.05 * cap_proxy),
                    max(1.0, 0.10 * cap_proxy),
                    max(1.0, p.case_pack(dst, ship_t)),
                ]
                for inc in increments:
                    if trials >= self._plt_ls_max_trials:
                        break
                    trials += 1
                    cand = dict(best_chrom)
                    cand[key] = max(0.0, base + inc)
                    cand_sol = self._dec.decode(cand)
                    if cand_sol.fitness + 1e-9 < best_f:
                        best_chrom = cand
                        best_sol = cand_sol
                        best_f = cand_sol.fitness
                        base = cand[key]
                        break

        # Suppress used arcs from source warehouses that are costly after shipping.
        if trials < self._plt_ls_max_trials:
            used_arcs = sorted(sol.Q_PLT.items(), key=lambda kv: -kv[1])
            for (src, dst, ship_t), q in used_arcs:
                if trials >= self._plt_ls_max_trials:
                    break
                if q <= 0:
                    continue
                source_inv = sol.I.get((src, ship_t), 0.0)
                if self._inventory_cost(src, ship_t, source_inv) <= 0:
                    continue
                key = qplt_key(src, dst, ship_t)
                base = float(best_chrom.get(key, q))
                for factor in (0.5, 0.0):
                    if trials >= self._plt_ls_max_trials:
                        break
                    cand = dict(best_chrom)
                    cand[key] = max(0.0, base * factor)
                    trials += 1
                    cand_sol = self._dec.decode(cand)
                    if cand_sol.fitness + 1e-9 < best_f:
                        best_chrom = cand
                        best_sol = cand_sol
                        best_f = cand_sol.fitness
                        break

        return best_sol, best_chrom

    # ------------------------------------------------------------------
    # Selection / replacement helpers
    # ------------------------------------------------------------------

    def _tournament_select(self, pop: List[Individual]) -> List[Individual]:
        selected: List[Individual] = []
        while len(selected) < self._n_pop:
            contestants = self._rng.choices(pop, k=min(self._k_tour, len(pop)))
            selected.append(min(contestants, key=lambda ind: ind.fitness))
        return selected

    def _evaluate_population(self, pop: List[Individual]) -> None:
        for ind in pop:
            self._ensure_plt_quantities(ind.chrom, noisy=False)
            if ind.sol is None or ind.fitness == float("inf"):
                sol = self._dec.decode(ind.chrom)
                ind.fitness = sol.fitness
                ind.sol = sol

    def _deduplicate(self, pop: List[Individual]) -> List[Individual]:
        seen = set()
        unique: List[Individual] = []
        for ind in pop:
            key = tuple(sorted(ind.chrom.items()))
            if key in seen:
                continue
            seen.add(key)
            unique.append(ind)
        return unique

    def _refill_population(self, pop: List[Individual]) -> None:
        while len(pop) < self._n_pop:
            ind = Individual(self._random_chromosome())
            self._evaluate_population([ind])
            pop.append(ind)

    @staticmethod
    def _clone_individual(ind: Individual) -> Individual:
        return Individual(dict(ind.chrom), ind.fitness, ind.sol)
